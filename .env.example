# ==============================================================================
# RN VALVES & FAUCETS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Add your real production credentials directly into Coolify / .env.production
# ==============================================================================

# Node Environment & Domain
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://rnvalves.com

# Production MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rn-valves?retryWrites=true&w=majority

# Admin Master Password & Security Secrets
ADMIN_MASTER_PASSWORD=your_admin_master_password
ADMIN_API_SECRET=your_admin_api_secret_key_64_chars
SESSION_SECRET=your_session_secret_key_64_chars
COOKIE_SECURE=true

# Razorpay Live Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# MSG91 OTP SMS Service
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_template_id
MSG91_BASE_URL=https://control.msg91.com/api/v5

# Cloudflare R2 Media Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_r2_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=rnfaucets-media
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_API_TOKEN=your_cloudflare_r2_api_token
NEXT_PUBLIC_MEDIA_URL=https://rnvalves.media

# Shipway Courier (Live Rates & Automatic AWB Generation)
SHIPWAY_USERNAME=your_shipway_username
SHIPWAY_PASSWORD=your_shipway_password
SHIPWAY_WAREHOUSE_ID=your_shipway_warehouse_id
SHIPWAY_PICKUP_PINCODE=201010

# Shiprocket Courier (Backup Courier)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_TOKEN=your_shiprocket_jwt_token
SHIPROCKET_PICKUP_LOCATION=Office
SHIPROCKET_PICKUP_PINCODE=201010

# Gmail SMTP Email (Order Invoices & Customer Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_email
SMTP_PASS=your_smtp_app_password
SMTP_FROM=RN Valves & Faucets <do-not-reply@rnvalves.com>
ADMIN_NOTIFICATION_EMAIL=ecommerce@rnvalves.com
