# Application Configuration
APP_NAME="RN Valves & Faucets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000

# Database Configuration
# If password contains @ # : / ? encode it (e.g. RN@1234 -> RN%401234)
MONGODB_URI=

# MSG91 OTP (https://msg91.com)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / Cloudflare R2 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# Recaptcha & Payments
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

RAZORPAY_KEY=
RAZORPAY_SECRET=

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=
OPENAI_API_KEY=

SHIPROCKET_TOKEN=

# Next.js Public Client Variables
NEXT_PUBLIC_APP_NAME="RN Valves & Faucets"
NEXT_PUBLIC_APP_URL=http://127.0.0.1:8000
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_GOOGLE_RECAPTCHA_KEY=
NEXT_PUBLIC_AWS_URL=
